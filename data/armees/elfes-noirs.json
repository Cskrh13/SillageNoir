  "specialRules": [
    {
      "id": "cleaving-blow",
      "name": "Coup de taille",
      "text": "Sur un 6 naturel pour blesser au corps à corps, certaines cibles d'infanterie ou de cavalerie perdent leurs sauvegardes d'armure et de Régénération."
    },
    {
      "id": "elven-reflexes",
      "name": "Réflexes elfiques",
      "text": "+1 Initiative lors du premier round de chaque combat, sans l'appliquer à la monture."
    },
    {
      "id": "eternal-hatred",
      "name": "Haine éternelle",
      "text": "Contre les Hauts-Elfes, la Haine s'applique à chaque round de corps à corps."
    },
    {
      "id": "hekarti-blessing",
      "name": "Bénédiction d'Hekarti",
      "text": "Une fois par partie, permet de relancer un test de lancement raté."
    },
    {
      "id": "martial-prowess",
      "name": "Maîtrise martiale",
      "text": "Les unités concernées peuvent effectuer des attaques de soutien sur leurs flancs et leur arrière."
    },
    {
      "id": "murderous",
      "name": "Meurtrier",
      "text": "Avec une seule arme de base non magique au corps à corps, relance les 1 naturels pour blesser."
    },
    {
      "id": "sea-dragon-cloak",
      "name": "Cape en peau de Dragon des Mers",
      "text": "Améliore de 1 la sauvegarde d'armure contre les tirs non magiques, jusqu'à 2+."
    },
    {
      "id": "goad-beast",
      "name": "Exciter la bête",
      "text": "Un Grand Maître des Bêtes peut donner +D3 Attaques à un monstre ami à portée de Commandement, jusqu'à 10."
    },
    {
      "id": "hidden",
      "name": "Dissimulé",
      "text": "L'Assassin peut commencer caché dans une unité d'infanterie amie de Force d'Unité suffisante et se révéler pendant la partie."
    },
    {
      "id": "dance-of-death",
      "name": "Danse de mort",
      "text": "Une unité de Sœurs du Massacre qui réussit une charge réduit temporairement le bonus de rang maximal de sa cible."
    },
    {
      "id": "cursed-coven",
      "name": "Coven maudit",
      "text": "Les Conjurateurs de Feu Maudit connaissent un sort lié de Magie Noire ou de Démonologie."
    },
    {
      "id": "dark-runes",
      "name": "Runes sombres",
      "text": "Sauvegarde invulnérable de 5+ contre les blessures causées par des attaques ennemies non magiques."
    },
    {
      "id": "wilful-beast",
      "name": "Bête indocile",
      "text": "Une Manticore montée doit tester son Commandement au début du tour ; en cas d'échec, elle gagne Frénésie jusqu'au prochain début de tour."
    },
    {
      "id": "stony-stare",
      "name": "Regard pétrifiant",
      "text": "Les ennemis au contact doivent tester leur Initiative au début de chaque phase de Combat ; en cas d'échec, ils subissent D3 touches de Force 2 sans sauvegarde d'armure."
    },
    {
      "id": "abyssal-howl",
      "name": "Hurlement abyssal",
      "text": "Les unités ennemies à 6 pouces subissent -1 Commandement, non cumulatif."
    }
