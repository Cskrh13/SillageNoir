```html
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Archives de l'Ancien Monde — Atelier de rédaction</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IM+Fell+English+SC&family=Vollkorn:wght@400;500;600&display=swap" rel="stylesheet">

<style>

:root {
    --fond: #15191a;
    --bleu-noir: #1b2325;
    --bleu-ardoise: #2d393d;
    --parchemin: #c8bd9d;
    --parchemin-clair: #ded4b7;
    --encre: #252a29;
    --texte-clair: #d8d1b8;
    --argent: #91a6aa;
    --ligne: rgba(125,139,140,.5);
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background:
        linear-gradient(rgba(170,145,105,.72), rgba(170,145,105,.72)),
        url("images/fond-carte.jpg");
    background-size: cover;
    background-attachment: fixed;
    color: var(--encre);
    font-family: "Vollkorn", Georgia, serif;
}

.page {
    width: calc(100% - 40px);
    max-width: 1200px;
    margin: 35px auto;
}

header {
    padding: 40px;
    text-align: center;
    color: var(--texte-clair);
    background:
        linear-gradient(rgba(25,32,34,.94), rgba(30,38,40,.94)),
        url("images/fond-carte.jpg");
    background-size: cover;
    border: 1px solid var(--ligne);
}

header h1 {
    margin: 0;
    font-family: "IM Fell English SC", Georgia, serif;
    font-size: clamp(32px, 5vw, 58px);
    font-weight: normal;
    letter-spacing: 4px;
}

header p {
    margin: 12px 0 0;
    color: #aaa89b;
    letter-spacing: 2px;
}

.editor {
    margin-top: 20px;
    padding: 30px;
    background: rgba(222,212,183,.95);
    border: 1px solid var(--ligne);
}

.grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.field {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.field.full {
    grid-column: 1 / -1;
}

label {
    font-weight: 600;
    color: #363b39;
}

input,
select,
textarea {
    width: 100%;
    padding: 11px 13px;
    border: 1px solid #9c9278;
    background: #eee7d1;
    color: #252a29;
    font-family: "Vollkorn", Georgia, serif;
    font-size: 15px;
}

textarea {
    min-height: 95px;
    resize: vertical;
}

.actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 25px;
}

button {
    padding: 12px 18px;
    border: 1px solid #596365;
    background: var(--bleu-noir);
    color: var(--texte-clair);
    font-family: "IM Fell English SC", Georgia, serif;
    cursor: pointer;
}

button:hover {
    background: var(--bleu-ardoise);
}

.preview {
    margin-top: 25px;
    padding: 30px;
    background:
        linear-gradient(rgba(25,32,34,.94), rgba(30,38,40,.94));
    color: var(--texte-clair);
    border: 1px solid var(--ligne);
}

.preview h2 {
    margin-top: 0;
    font-family: "IM Fell English SC", Georgia, serif;
    font-size: 32px;
    font-weight: normal;
}

.preview .subtitle {
    color: var(--argent);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 13px;
}

.preview .description {
    margin-top: 18px;
    line-height: 1.75;
}

.preview .promise {
    margin-top: 18px;
    padding: 15px;
    border-left: 2px solid #9d9271;
    color: #dcd5bd;
    font-style: italic;
}

.output {
    margin-top: 25px;
}

.output textarea {
    min-height: 300px;
    background: #15191a;
    color: #d8d1b8;
    font-family: Consolas, monospace;
    font-size: 13px;
}

.status {
    margin-top: 10px;
    color: #555;
}

@media(max-width: 750px) {
    .grid {
        grid-template-columns: 1fr;
    }

    .field.full {
        grid-column: auto;
    }
}

</style>
</head>

<body>

<div class="page">

<header>
    <h1>Atelier des Archives</h1>
    <p>Générateur de présentations pour l'Ancien Monde</p>
</header>

<section class="editor">

    <div class="grid">

        <div class="field">
            <label for="nom">Nom du contenu</label>
            <input id="nom" placeholder="Ex. La Marée de Sang">
        </div>

        <div class="field">
            <label for="type">Type de contenu</label>

            <select id="type">
                <option value="supplement">Supplément</option>
                <option value="campagne">Campagne narrative</option>
                <option value="cartes">Cartes de références</option>
                <option value="scenario">Scénario</option>
                <option value="armee">Livre / supplément d'armée</option>
                <option value="outil">Outil</option>
                <option value="autre">Autre création</option>
            </select>
        </div>

        <div class="field">
            <label for="peuple">Peuple / faction</label>
            <input id="peuple" placeholder="Ex. Druchii, Hauts-Elfes...">
        </div>

        <div class="field">
            <label for="statut">Statut</label>

            <select id="statut">
                <option value="disponible">Disponible</option>
                <option value="bientot">Bientôt disponible</option>
                <option value="archive">Archive</option>
            </select>
        </div>

        <div class="field full">
            <label for="accroche">Accroche</label>
            <textarea id="accroche"
                placeholder="Une phrase courte qui donne immédiatement envie de découvrir le contenu."></textarea>
        </div>

        <div class="field">
            <label for="contexte">Contexte</label>
            <textarea id="contexte"
                placeholder="Où se déroule l'histoire ? Quelle est la situation ?"></textarea>
        </div>

        <div class="field">
            <label for="contenu">Contenu</label>
            <textarea id="contenu"
                placeholder="Que contient concrètement le supplément ?"></textarea>
        </div>

        <div class="field full">
            <label for="promesse">Promesse pour le joueur</label>
            <textarea id="promesse"
                placeholder="Quelle expérience le joueur va-t-il vivre ?"></textarea>
        </div>

        <div class="field">
            <label for="image">Image</label>
            <input id="image" placeholder="images/couverture.jpg">
        </div>

        <div class="field">
            <label for="lien">Lien</label>
            <input id="lien" placeholder="https://...">
        </div>

    </div>

    <div class="actions">

        <button onclick="generer()">
            Générer la présentation
        </button>

        <button onclick="copierTexte()">
            Copier le texte
        </button>

        <button onclick="copierHTML()">
            Copier le HTML
        </button>

        <button onclick="effacer()">
            Effacer
        </button>

    </div>

    <div class="status" id="status"></div>

</section>


<section class="preview">

    <div class="subtitle" id="previewType">
        Supplément
    </div>

    <h2 id="previewNom">
        Votre contenu
    </h2>

    <div class="description" id="previewDescription">
        La présentation apparaîtra ici.
    </div>

    <div class="promise" id="previewPromise">
        La promesse pour le joueur apparaîtra ici.
    </div>

</section>


<section class="output">

    <label>
        Texte généré
    </label>

    <textarea id="outputText"></textarea>

</section>

</div>


<script>

const $ = id => document.getElementById(id);


/* =========================================================
   TYPES
   ========================================================= */

const types = {

    supplement: "Supplément",

    campagne: "Campagne narrative",

    cartes: "Cartes de références",

    scenario: "Scénario",

    armee: "Livre / supplément d'armée",

    outil: "Outil",

    autre: "Création"
};


/* =========================================================
   NETTOYAGE
   ========================================================= */

function nettoyer(texte) {

    return texte
        .trim()
        .replace(/\s+/g, " ");

}


/* =========================================================
   GÉNÉRATION DU TEXTE
   ========================================================= */

function genererTexte() {

    const nom = nettoyer($("nom").value);
    const type = $("type").value;
    const peuple = nettoyer($("peuple").value);
    const accroche = nettoyer($("accroche").value);
    const contexte = nettoyer($("contexte").value);
    const contenu = nettoyer($("contenu").value);
    const promesse = nettoyer($("promesse").value);
    const statut = $("statut").value;
    const lien = nettoyer($("lien").value);
    const image = nettoyer($("image").value);

    let description = "";

    if (accroche) {
        description += accroche + "\n\n";
    }

    if (contexte) {
        description += contexte + "\n\n";
    }

    if (contenu) {
        description += contenu;
    }

    let bouton = "";

    if (statut === "disponible" && lien) {

        bouton =
`<a class="download-button"
   href="${lien}"
   target="_blank"
   rel="noopener">
    Télécharger
</a>`;

    }

    if (statut === "bientot") {

        bouton =
`<span class="coming-soon">
    Bientôt disponible
</span>`;

    }

    const html =

`<article class="content-card">

    ${image ? `<img src="${image}" alt="${nom}">` : ""}

    <div class="content-card-body">

        <div class="content-type">
            ${types[type]}
        </div>

        <h3>
            ${nom || "Titre du contenu"}
        </h3>

        ${peuple ?
        `<div class="content-faction">
            ${peuple}
        </div>` : ""}

        <p>
            ${description
                .replace(/\n\n/g, "</p><p>")
                .replace(/\n/g, " ")}
        </p>

        ${promesse ?
        `<p class="content-promise">
            ${promesse}
        </p>` : ""}

        ${bouton}

    </div>

</article>`;

    return {
        nom,
        type,
        peuple,
        accroche,
        contexte,
        contenu,
        promesse,
        statut,
        lien,
        image,
        html
    };
}


/* =========================================================
   APERÇU
   ========================================================= */

function generer() {

    const data = genererTexte();

    $("previewType").textContent =
        types[data.type];

    $("previewNom").textContent =
        data.nom || "Votre contenu";

    let description = "";

    if (data.accroche)
        description += `<p>${data.accroche}</p>`;

    if (data.contexte)
        description += `<p>${data.contexte}</p>`;

    if (data.contenu)
        description += `<p>${data.contenu}</p>`;

    $("previewDescription").innerHTML =
        description || "La présentation apparaîtra ici.";

    $("previewPromise").textContent =
        data.promesse ||
        "La promesse pour le joueur apparaîtra ici.";

    $("outputText").value =
        construireTexte(data);

}


/* =========================================================
   TEXTE DESTINÉ À LA RÉDACTION
   ========================================================= */

function construireTexte(data) {

    let texte = "";

    texte += data.nom || "Titre";
    texte += "\n\n";

    texte += types[data.type];

    if (data.peuple)
        texte += " • " + data.peuple;

    texte += "\n\n";

    if (data.accroche)
        texte += data.accroche + "\n\n";

    if (data.contexte)
        texte += data.contexte + "\n\n";

    if (data.contenu)
        texte += data.contenu + "\n\n";

    if (data.promesse)
        texte += "PROMESSE JOUEUR\n" +
                 data.promesse + "\n\n";

    texte +=
        data.statut === "disponible"
            ? "STATUT : DISPONIBLE"
            : data.statut === "bientot"
                ? "STATUT : BIENTÔT DISPONIBLE"
                : "STATUT : ARCHIVE";

    if (data.lien)
        texte += "\nLIEN : " + data.lien;

    if (data.image)
        texte += "\nIMAGE : " + data.image;

    return texte;
}


/* =========================================================
   COPIE DU TEXTE
   ========================================================= */

async function copierTexte() {

    const texte = $("outputText").value;

    await navigator.clipboard.writeText(texte);

    afficherStatus("Texte copié.");

}


/* =========================================================
   COPIE DU HTML
   ========================================================= */

async function copierHTML() {

    const data = genererTexte();

    await navigator.clipboard.writeText(data.html);

    afficherStatus("HTML copié.");

}


/* =========================================================
   EFFACER
   ========================================================= */

function effacer() {

    document
        .querySelectorAll("input, textarea")
        .forEach(element => {
            element.value = "";
        });

    $("outputText").value = "";

    $("previewType").textContent = "Supplément";

    $("previewNom").textContent = "Votre contenu";

    $("previewDescription").textContent =
        "La présentation apparaîtra ici.";

    $("previewPromise").textContent =
        "La promesse pour le joueur apparaîtra ici.";

}


/* =========================================================
   MESSAGE
   ========================================================= */

function afficherStatus(message) {

    $("status").textContent = message;

    setTimeout(() => {

        $("status").textContent = "";

    }, 2500);

}


/* =========================================================
   MISE À JOUR AUTOMATIQUE DE L'APERÇU
   ========================================================= */

document
    .querySelectorAll("input, textarea, select")
    .forEach(element => {

        element.addEventListener(
            "input",
            generer
        );

        element.addEventListener(
            "change",
            generer
        );

    });


generer();

</script>

</body>
</html>
```
